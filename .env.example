# ── Facebook App(在 developers.facebook.com 建立)────────────────────
# App Secret:用來驗證 Webhook 簽章,務必保密
FB_APP_SECRET=
# 自己隨便取一組字串,填 Webhook 設定時要填一樣的
FB_VERIFY_TOKEN=my-verify-token-change-me
# 粉絲專頁的 Page Access Token(建議換成長期 token)
FB_PAGE_ACCESS_TOKEN=
# 粉絲專頁 ID
FB_PAGE_ID=
# Graph API 版本
FB_GRAPH_VERSION=v23.0

# ── 後台設定介面 ────────────────────────────────────────────────
# 登入後台用的密碼(給女友設定私訊內容用)
ADMIN_PASSWORD=change-me-please
# 簽 cookie 用的隨機字串,可用 `openssl rand -hex 32` 產生
SESSION_SECRET=

# ── 其他 ───────────────────────────────────────────────────────
PORT=3000
DATA_FILE=./data/store.json
# 演練模式:true = 不真的呼叫 Facebook,只寫紀錄(建議先用這個測)
DRY_RUN=false
# 每次呼叫 Graph API 之間最少間隔幾毫秒(避免被限流)
MIN_API_INTERVAL_MS=1200
