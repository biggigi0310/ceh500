{
  "name": "fb-comment-autoreply",
  "version": "2.0.0",
  "private": true,
  "description": "Facebook 粉專留言自動私訊物件連結 + 自動回覆「已私訊」(Cloudflare Workers)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create fb-autoreply",
    "db:init": "wrangler d1 execute fb-autoreply --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute fb-autoreply --local --file=./schema.sql",
    "tail": "wrangler tail",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
